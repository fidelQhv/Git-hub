# ============================================================
# Copia este archivo como ".env" y ajusta los valores:
#     cp .env.example .env
# El archivo .env NO se sube al repositorio (está en .gitignore).
# ============================================================

# ---- Aplicación ----
APP_PORT=3000
JWT_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# ---- Base de datos MySQL ----
MYSQL_DATABASE=automax
MYSQL_USER=automax
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
DB_EXPOSED_PORT=3307
